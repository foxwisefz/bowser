#!/usr/bin/env python3
"""Configure a source build's AI provider without putting credentials in shell history."""
import getpass
import json
import os
from pathlib import Path
import tempfile


def main():
    home = Path(os.environ.get("BOWSER_HOME", str(Path.home() / ".bowser-community")))
    provider = input("Provider [openai/anthropic]: ").strip().lower()
    if provider not in ("openai", "anthropic"):
        raise SystemExit("Choose openai or anthropic; no settings changed.")
    key = getpass.getpass("API key (hidden): ").strip()
    if not key:
        raise SystemExit("Empty key; no settings changed.")
    model = input("Model ID (blank for provider default): ").strip()
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = home / "settings.json"
    settings = json.loads(path.read_text()) if path.exists() else {}
    settings.update(ai_provider=provider)
    settings[provider + "_api_key"] = key
    if model:
        settings["modsmith_model"] = model
    else:
        settings.pop("modsmith_model", None)
    fd, temporary = tempfile.mkstemp(prefix=".settings-", dir=home)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(settings, output, indent=2)
            output.write("\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Configured {provider} in {path}; no request was sent.")


if __name__ == "__main__":
    main()
