#!/usr/bin/env swift
// Developer gate only. Launch a signed optimized bundle with disposable state.
import Foundation
import Darwin

func failure(_ message: String) -> NSError { NSError(domain: message, code: 1) }

func run() throws {
let fm = FileManager.default
let repo = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent()
let binary = CommandLine.arguments.dropFirst().first.map { URL(fileURLWithPath: $0) }
    ?? repo.appendingPathComponent("shell/.build/release/Bowser")
let root = URL(fileURLWithPath: "/tmp/br-" + UUID().uuidString.prefix(8))
let bundle = root.appendingPathComponent("Bowser.app")
let mac = bundle.appendingPathComponent("Contents/MacOS")
let home = root.appendingPathComponent("home")
try fm.createDirectory(at: mac, withIntermediateDirectories: true)
try fm.createDirectory(at: home, withIntermediateDirectories: true)
defer { try? fm.removeItem(at: root) }
try fm.copyItem(at: binary, to: mac.appendingPathComponent("Bowser"))
let frameworks = bundle.appendingPathComponent("Contents/Frameworks")
try fm.createDirectory(at: frameworks, withIntermediateDirectories: true)
try fm.copyItem(at: binary.deletingLastPathComponent().appendingPathComponent("libBowserSurfaceKit.dylib"),
                to: frameworks.appendingPathComponent("libBowserSurfaceKit.dylib"))
let template = try String(contentsOf: repo.appendingPathComponent("bin/Info.plist"), encoding: .utf8)
let plist = template.replacingOccurrences(of: "__VERSION__", with: "test")
    .replacingOccurrences(of: "__BUILD__", with: "1")
    .replacingOccurrences(of: "com.foxwiseai.bowser", with: "com.foxwiseai.bowser.release-test")
try plist.write(to: bundle.appendingPathComponent("Contents/Info.plist"), atomically: true, encoding: .utf8)
let sign = Process()
sign.executableURL = URL(fileURLWithPath: "/usr/bin/codesign")
sign.arguments = ["--force", "--deep", "--sign", "-", bundle.path]
try sign.run(); sign.waitUntilExit()
guard sign.terminationStatus == 0 else { throw failure("fixture signing failed") }
// A fresh install stays alive at the welcome screen without starting the
// engine listener, even when an old session file or personal keys exist.
try Data("{}".utf8).write(to: home.appendingPathComponent("session.json"))
try Data(#"{"ai_provider":"openai","openai_api_key":"fixture"}"#.utf8)
    .write(to: home.appendingPathComponent("settings.json"))
let gated = Process()
gated.executableURL = mac.appendingPathComponent("Bowser")
gated.environment = ProcessInfo.processInfo.environment.merging([
    "BOWSER_HOME": home.path, "BOWSER_API_ENDPOINT": "http://127.0.0.1:1"
]) { _, new in new }
gated.standardOutput = FileHandle.nullDevice; gated.standardError = FileHandle.nullDevice
try gated.run()
do {
    defer {
        if gated.isRunning { gated.terminate() }
        let until = Date().addingTimeInterval(2)
        while gated.isRunning && Date() < until { Thread.sleep(forTimeInterval: 0.02) }
        if gated.isRunning { kill(gated.processIdentifier, SIGKILL) }
        gated.waitUntilExit()
    }
    let deadline = Date().addingTimeInterval(3)
    while Date() < deadline {
        guard gated.isRunning else { throw failure("unactivated app exited") }
        guard !fm.fileExists(atPath: home.appendingPathComponent("brain.sock").path) else {
            throw failure("unactivated app started browser engine")
        }
        Thread.sleep(forTimeInterval: 0.05)
    }
}
print("Unactivated bundle stayed at admission gate without starting the browser engine")
let receipt: [String: Any] = ["registrationID": "launch-fixture", "telemetryToken": "fixture-token",
    "request": ["requestID": UUID().uuidString, "email": "fixture@example.invalid",
                "termsVersion": "fixture", "acceptedAt": 0]]
try JSONSerialization.data(withJSONObject: receipt).write(to: home.appendingPathComponent("registration.json"))
let app = Process()
app.executableURL = mac.appendingPathComponent("Bowser")
app.environment = ProcessInfo.processInfo.environment.merging(["BOWSER_HOME": home.path]) { _, new in new }
app.standardOutput = FileHandle.nullDevice
app.standardError = FileHandle.nullDevice
try app.run()
defer {
    if app.isRunning { app.terminate() }
    let until = Date().addingTimeInterval(2)
    while app.isRunning && Date() < until { Thread.sleep(forTimeInterval: 0.02) }
    if app.isRunning { kill(app.processIdentifier, SIGKILL) }
    app.waitUntilExit()
}
let deadline = Date().addingTimeInterval(10)
let path = home.appendingPathComponent("brain.sock").path
while !fm.fileExists(atPath: path) && app.isRunning && Date() < deadline { Thread.sleep(forTimeInterval: 0.02) }
guard app.isRunning else { throw failure("optimized bundle exited: \(app.terminationStatus)") }
let fd = socket(AF_UNIX, SOCK_STREAM, 0)
guard fd >= 0 else { throw failure("socket failed") }
defer { close(fd) }
var address = sockaddr_un()
address.sun_family = sa_family_t(AF_UNIX)
withUnsafeMutableBytes(of: &address.sun_path) { bytes in
    for (index, byte) in path.utf8.enumerated() { bytes[index] = byte }
}
let connected = withUnsafePointer(to: &address) {
    $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { connect(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
}
guard connected == 0 else { throw failure("listener unavailable: \(errno)") }
func readExactly(_ count: Int) throws -> Data {
    var result = Data()
    while result.count < count {
        var pollFD = pollfd(fd: fd, events: Int16(POLLIN), revents: 0)
        guard Date() < deadline, poll(&pollFD, 1, 200) >= 0 else { throw NSError(domain: "listener timeout", code: 1) }
        if pollFD.revents == 0 { continue }
        var buffer = [UInt8](repeating: 0, count: count - result.count)
        let n = read(fd, &buffer, buffer.count)
        guard n > 0 else { throw NSError(domain: "listener disconnected", code: 2) }
        result.append(contentsOf: buffer.prefix(n))
    }
    return result
}
while true {
    let header = try readExactly(4)
    let size = header.reduce(0) { ($0 << 8) | Int($1) }
    guard size > 0 && size < 1_000_000 else { throw failure("invalid frame") }
    let object = try JSONSerialization.jsonObject(with: readExactly(size)) as? [String: Any]
    if object?["op"] as? String == "hello" {
        guard object?["v"] as? Int == 1, object?["tabs"] is [[String: Any]] else { throw failure("invalid hello") }
        guard let buildID = object?["engine_build_id"] as? String,
              buildID.count == 32,
              object?["engine_binary"] as? String == mac.appendingPathComponent("Bowser").path else {
            throw failure("missing engine build identity")
        }
        let dwarfdump = Process()
        dwarfdump.executableURL = URL(fileURLWithPath: "/usr/bin/dwarfdump")
        dwarfdump.arguments = ["--uuid", mac.appendingPathComponent("Bowser").path]
        let output = Pipe(); dwarfdump.standardOutput = output
        try dwarfdump.run()
        let uuidText = String(decoding: output.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self)
        dwarfdump.waitUntilExit()
        guard dwarfdump.terminationStatus == 0,
              uuidText.replacingOccurrences(of: "-", with: "").lowercased().contains(buildID) else {
            throw failure("mapped build does not match executable UUID")
        }
        print("Signed optimized bundle returned protocol hello and matching mapped build identity with isolated state")
        break
    }
}

}
do { try run() } catch {
    FileHandle.standardError.write(Data("Release launch gate failed: \(error)\n".utf8))
    exit(1)
}
